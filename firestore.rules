rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primtive define
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // 3. User Blueprint
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) && 
             data.keys().size() <= 20 &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256;
    }

    // Push notification preferences and device tokens
    function isValidPushPreference(data) {
      return data.keys().hasOnly(['enabled', 'permissionStatus', 'token', 'updatedAt']) &&
             data.enabled is bool &&
             data.permissionStatus in ['authorized', 'denied', 'notDetermined', 'unavailable'] &&
             (!('token' in data) || data.token == null || data.token is string);
    }

    function isValidPushToken(data) {
      return data.keys().hasOnly(['token', 'enabled', 'platform', 'createdAt', 'updatedAt']) &&
             data.token is string &&
             data.token.size() <= 4096 &&
             data.enabled is bool &&
             data.platform in ['android', 'ios', 'web', 'windows', 'macos'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());

      match /settings/{settingId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create, update: if isOwner(userId) &&
                              settingId == 'push_notifications' &&
                              isValidPushPreference(incoming());
        allow delete: if false;
      }

      match /push_tokens/{tokenId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPushToken(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // 4. Transaction Blueprint
    function isValidAccount(data) {
      return data.keys().hasAll(['userId', 'name', 'accountType', 'accountKind', 'balance', 'currency', 'source', 'isManual', 'isActive']) &&
        data.keys().hasOnly(['userId', 'name', 'accountType', 'accountKind', 'institutionId', 'institutionName', 'institutionIcon', 'agency', 'accountNumber', 'balance', 'currency', 'source', 'openFinanceProviderId', 'openFinanceConsentId', 'openFinanceStatus', 'isManual', 'isActive', 'createdAt', 'updatedAt']) &&
        isOwner(data.userId) && data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.accountType in ['checking', 'savings', 'salary', 'payment', 'investment', 'cash'] &&
        data.accountKind in ['bank', 'wallet', 'cash', 'investment'] &&
        data.balance is number && data.currency == 'BRL' &&
        data.source in ['manual', 'open_finance'] && data.isManual is bool && data.isActive is bool;
    }

    match /accounts/{accountId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidAccount(incoming());
      allow update: if isOwner(existing().userId) && incoming().userId == existing().userId && isValidAccount(incoming());
      allow delete: if isOwner(existing().userId);
    }

    function hasOnlyValidTransactionFields(data) {
      return data.keys().hasOnly([
        'userId',
        'title',
        'description',
        'amount',
        'date',
        'category',
        'categoryColor',
        'type',
        'icon',
        'status',
        'isCardCharge',
        'cardId',
        'cardName',
        'paymentMethod',
        'notes', 'publicId', 'sourceType', 'sourceName', 'accountId',
        'installmentGroupId', 'installmentNumber', 'installmentTotal',
        'parentTransactionId', 'recurrencePeriod', 'nextBilling', 'transactionEvents',
        'installments',
        'currentInstallment',
        'isRecurring',
        'createdMs',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'title', 'amount', 'date', 'type']) &&
             hasOnlyValidTransactionFields(data) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.amount is number &&
             data.date is string &&
             data.type in ['income', 'expense'] &&
             (!('description' in data) || data.description is string) &&
             (!('category' in data) || data.category is string) &&
             (!('categoryColor' in data) || data.categoryColor is string) &&
             (!('icon' in data) || data.icon is string) &&
             (!('status' in data) || data.status in ['completed', 'pending', 'paid', 'canceled']) &&
             (!('isCardCharge' in data) || data.isCardCharge is bool) &&
             (!('cardId' in data) || data.cardId is string) &&
             (!('cardName' in data) || data.cardName is string) &&
             (!('paymentMethod' in data) || data.paymentMethod is string) &&
             (!('accountId' in data) || data.accountId is string) &&
             (!('sourceType' in data) || data.sourceType in ['account', 'card']) &&
             (!('sourceName' in data) || data.sourceName is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('publicId' in data) || data.publicId is string) &&
             (!('transactionEvents' in data) || data.transactionEvents is list) &&
             (!('installments' in data) || data.installments is number) &&
             (!('currentInstallment' in data) || data.currentInstallment is number) &&
             (!('isRecurring' in data) || data.isRecurring is bool) &&
             (!('createdMs' in data) || data.createdMs is number);
    }

    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidTransaction(incoming()) && 
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    // Credit Cards Blueprint
    function hasOnlyValidCardFields(data) {
      return data.keys().hasOnly([
        'userId',
        'name',
        'cardName',
        'brand',
        'finalDigits',
        'lastFourDigits',
        'expiration',
        'expirationDate',
        'bestDay',
        'closingDay',
        'dueDay',
        'dueDate',
        'totalLimit',
        'creditLimit',
        'limit',
        'usedLimit',
        'lastPaidMonth',
        'isMonthPaid',
        'isVirtual',
        'isBlocked',
        'colorClass',
        'color',
        'theme',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidCard(data) {
      return data.keys().hasAll(['userId', 'brand']) &&
             (('name' in data && data.name is string && data.name.size() <= 100) ||
              ('cardName' in data && data.cardName is string && data.cardName.size() <= 100)) &&
             (('finalDigits' in data && data.finalDigits is string && data.finalDigits.size() <= 4) ||
              ('lastFourDigits' in data && data.lastFourDigits is string && data.lastFourDigits.size() <= 4)) &&
             (('expiration' in data && data.expiration is string && data.expiration.size() <= 10) ||
              ('expirationDate' in data && data.expirationDate is string && data.expirationDate.size() <= 10)) &&
             (('bestDay' in data && (data.bestDay is string || data.bestDay is number)) ||
              ('closingDay' in data && data.closingDay is number) ||
              ('dueDay' in data && data.dueDay is number) ||
              ('dueDate' in data && data.dueDate is string)) &&
             (('totalLimit' in data && data.totalLimit is number) ||
              ('creditLimit' in data && data.creditLimit is number) ||
              ('limit' in data && data.limit is number)) &&
             hasOnlyValidCardFields(data) &&
             data.userId == request.auth.uid &&
             data.brand is string && data.brand.size() <= 50 &&
             (!('usedLimit' in data) || data.usedLimit is number) &&
             (!('lastPaidMonth' in data) || data.lastPaidMonth is string) &&
             (!('isMonthPaid' in data) || data.isMonthPaid is bool);
    }

    match /cards/{cardId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCard(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
                    incoming().userId == existing().userId &&
                    isValidCard(incoming());
      allow delete: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    // 5. Subscription Blueprint
    function hasOnlyValidSubscriptionFields(data) {
      return data.keys().hasOnly([
        'userId',
        'name',
        'amount',
        'period',
        'billingCycle',
        'nextBilling',
        'renewalDate',
        'icon',
        'iconUrl',
        'color',
        'category',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['userId', 'name', 'amount', 'period', 'nextBilling']) &&
             hasOnlyValidSubscriptionFields(data) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.amount is number &&
             data.period in ['Mensal', 'Trimestral', 'Semestral', 'Anual'] &&
             (!('billingCycle' in data) || data.billingCycle in ['monthly', 'quarterly', 'semiannual', 'annual']) &&
             data.nextBilling is string &&
             (!('renewalDate' in data) || data.renewalDate is string) &&
             (!('icon' in data) || data.icon is string) &&
             (!('iconUrl' in data) || data.iconUrl is string) &&
             (!('color' in data) || data.color is string) &&
             (!('category' in data) || data.category is string) &&
             (!('status' in data) || data.status in ['active', 'canceled', 'paused']);
    }

    match /subscriptions/{subscriptionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidSubscription(incoming());
      allow update: if isSignedIn() && isValidSubscription(incoming()) && 
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    // 6. Goal Blueprint
    function isValidGoal(data) {
      return data.keys().hasAll(['userId', 'title', 'currentAmount', 'targetAmount']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.currentAmount is number &&
             data.targetAmount is number;
    }

    match /goals/{goalId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidGoal(incoming());
      allow update: if isSignedIn() && isValidGoal(incoming()) && 
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    // 7. Budget Category Blueprint
    function isValidBudgetCategory(data) {
      return data.keys().hasAll(['userId', 'name', 'icon']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'percentage', 'icon', 'limitAmount', 'type', 'color', 'backgroundColor', 'description', 'aliases', 'active', 'isActive', 'enabled', 'order', 'sortOrder', 'position', 'createdAt', 'updatedAt', 'deleted', 'defaultCategoryId']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             (!('percentage' in data) || (data.percentage is number && data.percentage >= 0 && data.percentage <= 100)) &&
             (!('limitAmount' in data) || (data.limitAmount is number && data.limitAmount >= 0)) &&
             (!('deleted' in data) || data.deleted is bool) &&
             (!('defaultCategoryId' in data) || data.defaultCategoryId is string) &&
             (!('type' in data) || data.type in ['expense', 'income']) &&
             data.icon is string && data.icon.size() <= 50;
    }

    match /budgets/{budgetId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidBudgetCategory(incoming());
      allow update: if isSignedIn() && isValidBudgetCategory(incoming()) && 
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    // 8. Subscription Templates (Public Catalog)
    match /subscription_templates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // 9. Subscription Plans (Configurable SaaS Catalog)
    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // System-wide notifications shown inside the app.
    match /system_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
