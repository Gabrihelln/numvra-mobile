FIREBASE_AUTH_DOMAIN=numvra-main.firebaseapp.com
FIREBASE_PROJECT_ID=numvra-main
FIREBASE_MESSAGING_SENDER_ID=999637138962
FIREBASE_APP_ID=1:999637138962:web:234cb1b5a215a5420ba2cb

# OAuth 2.0 Web client ID from the same Firebase/Google Cloud project.
# Required by the native Android Google Sign-In module to return an ID token.
GOOGLE_WEB_CLIENT_ID=

# Backend API Configuration. This must be the HTTPS address of the secure
# Numvra backend that creates Stripe Checkout Sessions and handles webhooks.
# Never add Stripe secret keys or webhook secrets to this file or the mobile .env.
API_BASE_URL=https://api.numvra.com
STRIPE_PUBLISHABLE_KEY=pk_live_51TdB3E4kazFFFVAjH5ktbHCthncsbIk4SoG3tuegrm5enHEjwl6BBkwjBz6OX97z3SjAnt6vtFzFNrPeEOLtSnx200c39E0gbP
ENABLE_MOBILE_PAYMENT_SHEET=true

# Server-side Notification Scheduler (VPS)
# Use GOOGLE_APPLICATION_CREDENTIALS pointing to a Firebase Admin service account JSON,
# or set FIREBASE_SERVICE_ACCOUNT with the complete JSON value. Never commit service account files.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
NOTIFICATION_SCHEDULER_INTERVAL_MS=300000
NOTIFICATION_LOOKAHEAD_DAYS=3
BUDGET_WARNING_THRESHOLD=0.8
TZ=America/Sao_Paulo
MANUAL_NOTIFICATION_LOOKBACK_MINUTES=1440
MANUAL_NOTIFICATION_SCAN_LIMIT=100
